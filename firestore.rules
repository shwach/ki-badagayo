rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 유저: 본인만 쓰기
    match /users/{uid} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['kiBalance','lastDailyKi','displayName','photoURL','lastClaimDate'])
                    || request.auth.uid == 'WS3FQ9JICAYPgibggl2bEgNG3Bv2';
    }

    // 자랑글: 생성만 허용 (수정/삭제 불가)
    match /posts/{postId} {
      allow read:   if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.authorId
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 300
                    && request.resource.data.kiPool  >= 1
                    && request.resource.data.kiPool  == request.resource.data.kiRemaining
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned != true;
      // kiRemaining 차감은 트랜잭션으로만 허용
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['kiRemaining'])
                    && request.resource.data.kiRemaining == resource.data.kiRemaining - 1
                    && resource.data.kiRemaining > 0;
      allow delete: if request.auth != null
                    && request.auth.uid == 'WS3FQ9JICAYPgibggl2bEgNG3Bv2';
    }

    // 일일 클레임: 본인 문서만 생성, ID는 날짜_uid 형식 강제
    match /posts/{postId}/dailyClaims/{claimId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.postId == postId;
      allow update, delete: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 유저: 본인만 쓰기
    match /users/{uid} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['kiBalance','lastDailyKi','displayName','photoURL','lastClaimDate']);
    }

    // 자랑글: 생성만 허용 (수정/삭제 불가)
    match /posts/{postId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.authorId
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 300
                    && (
                         // 일반 유저 자랑글: 기 풀 필수
                         ( ('kiPool' in request.resource.data)
                           && request.resource.data.kiPool >= 1
                           && request.resource.data.kiPool == request.resource.data.kiRemaining )
                         // 관리자 자랑글: 기 무제한 (kiPool/kiRemaining 없음, 차감 안 됨)
                         || ( request.resource.data.get('isAdmin', false) == true
                              && request.auth.uid == 'WS3FQ9JICAYPgibggl2bEgNG3Bv2' )
                       );
      // kiRemaining 차감은 트랜잭션으로만 허용 (일반 자랑글만, 관리자 글은 차감되지 않음)
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['kiRemaining'])
                    && request.resource.data.kiRemaining == resource.data.kiRemaining - 1
                    && resource.data.kiRemaining > 0;
      allow delete: if false;
    }

    // 일일 클레임: 본인 문서만 생성, ID는 날짜_uid 형식 강제
    match /posts/{postId}/dailyClaims/{claimId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.postId == postId;
      allow update, delete: if false;
    }
  }
}
